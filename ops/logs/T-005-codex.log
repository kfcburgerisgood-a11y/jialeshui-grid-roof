"""The brief: every number the roof depends on, in one place."""

import dataclasses
import json
from dataclasses import dataclass, field

__all__ = ["Brief"]


@dataclass
class Brief:
    """Every number the roof depends on, with defaults, in millimetres.

    Saves to and loads from JSON, so ``build.py`` builds exactly what the
    walkthrough designed. Each step's docstring lists the fields it reads.

    Examples
    --------
    >>> brief = Brief(beam=500.0)
    >>> brief.bounds
    (0.0, 0.0, 0.0, 18000.0, 12000.0, 600.0)
    >>> Brief.from_dict(brief.to_dict()) == brief
    True
    """

    # the brief
    length: float = 18000.0
    width: float = 12000.0
    thickness: float = 600.0
    grid_x: list = field(default_factory=lambda: [0.0, 6000.0, 12000.0, 18000.0])
    grid_y: list = field(default_factory=lambda: [0.0, 6000.0, 12000.0])
    beam: float = 600.0                 # beam width
    beam_depth: float = 500.0           # depth every beam keeps, from the soffit

    # water
    fall: float = 1 / 60                # deck falls to the drains
    relief: float = 25.0                # undulation, so water meanders
    relief_seed: int = 11
    plan_cell: float = 50.0             # drainage grid
    upstand: float = 150.0              # how far water is kept off a light opening
    channel_onset: float = 1.5e6        # catchment where a channel starts, mm2
    channel_width: float = 220.0        # at 10 m2 of catchment
    channel_depth: float = 80.0         # at 10 m2 of catchment
    channel_limit: float = 170.0        # deepest any channel may be
    channel_reach: float = 260.0        # lowest a channel bed may go below the top, off the beams

    # the soffit
    skin: float = 120.0                 # solid deck over the pores
    pore: float = 700.0                 # pore to pore
    fraction_deck: float = 0.95         # solid share just under the deck
    fraction_soffit: float = 0.42       # solid share at the soffit
    beam_haunch: float = 900.0          # how far from a beam the foam closes up
    foam_seed: int = 8

    # light and planters
    opening_flare: float = 260.0        # wider at the faces than at mid-depth
    planter_depth: float = 350.0
    planter_rim: float = 220.0
    planter_wall: float = 150.0
    outlet: float = 80.0                # rainwater outlet bore radius

    # fabrication
    panel: float = 3000.0               # largest panel
    cut_shift: float = 450.0            # how far a panel joint may move off an even split
    clearance: float = 10.0             # joint gap
    dowel: float = 60.0                 # dowel diameter
    dowel_fit: float = 2.0              # radial clearance of a dowel in its socket
    min_feature: float = 80.0           # thinnest wall that may survive
    pit_depth: float = 60.0
    wear: float = 20.0
    erosion_margin: float = 150.0       # erosion fades out over this distance from what is kept
    hardness_seed: int = 3
    halo: float = 320.0                 # margin each piece is weathered with
    voxel: float = 40.0                 # 40 to look, 10 - 15 to make

    @property
    def bounds(self):
        """tuple: ``(xmin, ymin, zmin, xmax, ymax, zmax)`` of the slab."""
        return (0.0, 0.0, 0.0, float(self.length), float(self.width), float(self.thickness))

    def to_dict(self):
        return dataclasses.asdict(self)

    @classmethod
    def from_dict(cls, data):
        known = {f.name for f in dataclasses.fields(cls)}
        unknown = set(data) - known
        if unknown:
            raise ValueError("Not in the brief: {}".format(", ".join(sorted(unknown))))
        return cls(**data)

    def save(self, path):
        with open(path, "w", encoding="utf-8") as f:
            json.dump(self.to_dict(), f, indent=1)
        return path

    @classmethod
    def load(cls, path):
        with open(path, encoding="utf-8") as f:
            return cls.from_dict(json.load(f))
"""The checks the brief's rules need, beyond what compas_vol checks for any model."""

import numpy as np

from .design import region

__all__ = ["clear_apertures", "beam_depth"]


def clear_apertures(brief, drawing, roof, step=50.0):
    """For each light opening: the area drawn, and the area with a clear line of sight through the slab, in m2.

    Read off the design. Every process after it only removes material outside
    what is kept, so this is a lower bound on what is built -- unless a kept
    beam crosses an opening, which shows here as a shortfall.
    """
    result = []
    for outline in drawing.openings:
        xs, ys = np.array(outline)[:, 0], np.array(outline)[:, 1]
        reach = brief.opening_flare + step
        gx = np.arange(xs.min() - reach, xs.max() + reach, step)
        gy = np.arange(ys.min() - reach, ys.max() + reach, step)
        zs = np.linspace(1.0, brief.thickness - 1.0, 13)
        values = roof.get_distance_numpy(gx[:, None, None], gy[None, :, None], zs[None, None, :])
        clear = (values > 0).all(axis=2).sum() * step * step / 1e6
        inside = region(outline, -1, 1).get_distance_numpy(gx[:, None, None], gy[None, :, None], np.zeros((1, 1, 1)))
        result.append({"drawn": float((inside < 0).sum() * step * step / 1e6), "clear": float(clear)})
    return result


def beam_depth(field, beams, bounds):
    """The least continuous solid above the soffit, over every column inside a beam, in mm.

    Measure the weathered field, before the joints: a dowel socket would read
    as lost depth. ``None`` for a piece with no beam in it.
    """
    x, y, z = field.coordinates()
    px, py = np.broadcast_arrays(x[:, :, 0], y[:, :, 0])
    inside = np.zeros(px.shape, dtype=bool)
    for lo, hi in beams.xbands:
        inside |= (px > lo) & (px < hi)
    for lo, hi in beams.ybands:
        inside |= (py > lo) & (py < hi)
    inside &= (px > bounds[0]) & (px < bounds[3]) & (py > bounds[1]) & (py < bounds[4])
    if not inside.any():
        return None
    zs = z[0, 0, :]
    above = zs > 0
    solid = field.values[:, :, above] < 0
    heights = zs[above]
    first_void = np.argmax(~solid, axis=2)
    depth = np.where((~solid).any(axis=2), heights[first_void] - 0.5 * (heights[1] - heights[0]), heights[-1])
    return float(np.where(solid[:, :, 0], depth, 0.0)[inside].min())
"""M2 body: closed A test mesh -> shell field signs and thickness."""
import numpy as np
import pytest
from grid_roof import body as B


@pytest.fixture(scope="module")
def shell():
    return B.body_shell(B.body_field(B.test_box_a(), voxel=100.0))


def test_test_body_is_closed_and_in_mm():
    m = B.test_box_a()
    assert m.is_closed()
    p = np.array([m.vertex_coordinates(v) for v in m.vertices()])
    assert np.allclose(p.min(0), 0) and np.allclose(p.max(0), [10000, 6000, 4000])


def test_shell_signs(shell):
    d = lambda *p: float(shell.get_distance(p))  # noqa: E731
    assert d(5000, 3000, 150) == pytest.approx(-150, abs=40)    # mid-wall of floor: about -T/2
    assert d(5000, 3000, 2000) > 0                              # hollow inside
    assert d(5000, 3000, 4300) > 0                              # outside


def test_design_body_runs(shell):
    d = B.design_body(shell)
    assert float(d.roof.get_distance([5000, 3000, 150])) < 0
"""The roof's steps: they run, they keep their rules, and the brief and drawing round-trip."""

import pytest

import grid_roof as roof
from compas_vol import nodes
from compas_vol.assembly import Seams
from compas_vol.meshing import is_watertight

pytest.importorskip("skfmm", reason="needs the processes extra")


@pytest.fixture(scope="module")
def brief():
    return roof.Brief(voxel=60.0)


@pytest.fixture(scope="module")
def drawing():
    return roof.Drawing.sample()


@pytest.fixture(scope="module")
def built(brief, drawing):
    return roof.design_roof(brief, drawing)


def test_brief_and_drawing_round_trip(tmp_path, brief, drawing):
    assert roof.Brief.load(brief.save(tmp_path / "brief.json")) == brief
    again = roof.Drawing.load(drawing.save(str(tmp_path / "drawing.json")))
    assert [list(p) for p in again.drains] == [list(p) for p in drawing.drains]
    assert len(again.openings[0]) == len(drawing.openings[0])


def test_a_brief_rejects_unknown_fields():
    with pytest.raises(ValueError, match="Not in the brief"):
        roof.Brief.from_dict({"beams": 600})


def test_the_water_drains(built):
    summary = built.incision.summary()
    assert summary["stranded"] == 0 and summary["reverse_falls"] == 0
    assert summary["outlets_used"] == summary["outlets"]


def test_channels_never_cut_a_beam_below_its_depth(brief, built):
    import numpy as np

    surface = built.incision.surface
    x = np.arange(surface.shape[0]) * brief.plan_cell
    on_beam = np.zeros(surface.shape, dtype=bool)
    for lo, hi in built.beams.xbands:
        on_beam |= ((x >= lo) & (x <= hi))[:, None]
    assert surface[on_beam].min() >= brief.beam_depth - 1e-6


def test_light_goes_through(brief, drawing, built):
    for aperture in roof.clear_apertures(brief, drawing, built.design.roof):
        assert aperture["clear"] >= 0.9 * aperture["drawn"]


def test_the_kit_follows_the_beam_grid(built):
    roles = [piece.role for piece in built.assembly]
    assert (roles.count("node"), roles.count("beam"), roles.count("panel")) == (12, 17, 24)


def test_a_weathered_beam_keeps_its_depth_and_meets_its_neighbour(brief, built):
    pieces = [built.assembly.find(name) for name in ("node_1_1", "beam_x1_1_0")]
    seams = Seams(built.assembly, brief.voxel)
    for piece, field, raw in built.assembly.build(built.weathering, brief.voxel, brief.halo, pieces=pieces,
                                                  seams=seams):
        assert raw.violation()["keep"] < brief.voxel
        assert roof.beam_depth(raw, built.beams, piece.bounds) >= brief.beam_depth - brief.voxel
        vertices, faces = nodes.mesh(field.to_volume(), None, None, 0)
        assert is_watertight(vertices, faces)
    assert seams.summary()["faces"] == 1 and seams.summary()["disagreement"] < 0.01
"""The walkthrough is code too: it must parse, and call nothing that no longer exists.

Executing them is a few minutes of processes, so it is left to whoever edits
them (see the notebook's own header). This catches the usual way a notebook
rots without running it: an API it calls has moved on.
"""

import ast
import json
import os

import pytest

FOLDER = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
NOTEBOOKS = sorted(f for f in os.listdir(FOLDER) if f.endswith(".ipynb")) if os.path.isdir(FOLDER) else []


def code_of(name):
    with open(os.path.join(FOLDER, name), encoding="utf-8") as f:
        cells = json.load(f)["cells"]
    sources = ["".join(c["source"]) for c in cells if c["cell_type"] == "code"]
    # IPython magics are not Python.
    return "\n".join(line for source in sources for line in source.splitlines() if not line.startswith("%"))


@pytest.mark.parametrize("name", NOTEBOOKS)
def test_notebook_parses(name):
    ast.parse(code_of(name), feature_version=(3, 9))


@pytest.mark.parametrize("name", NOTEBOOKS)
def test_notebook_calls_only_nodes_that_exist(name):
    """`nodes.box` in a notebook is the Box component; if it calls one, it has to still be there."""
    from compas_vol import nodes

    used = {
        node.attr for node in ast.walk(ast.parse(code_of(name)))
        if isinstance(node, ast.Attribute) and isinstance(node.value, ast.Name) and node.value.id == "nodes"
    }
    assert used <= set(nodes.__all__), "gone from compas_vol.nodes: {}".format(sorted(used - set(nodes.__all__)))


@pytest.mark.parametrize("name", NOTEBOOKS)
def test_notebook_imports_resolve(name):
    import importlib

    tree = ast.parse(code_of(name))
    for node in ast.walk(tree):
        ours = node.module.split(".")[0] in ("compas_vol", "grid_roof") if isinstance(node, ast.ImportFrom) else False
        if ours:
            module = importlib.import_module(node.module)
            for alias in node.names:
                assert hasattr(module, alias.name), "{}.{} is gone".format(node.module, alias.name)


@pytest.mark.parametrize("name", NOTEBOOKS)
def test_notebook_was_saved_without_errors(name):
    with open(os.path.join(FOLDER, name), encoding="utf-8") as f:
        cells = json.load(f)["cells"]
    errors = [o for c in cells for o in c.get("outputs", []) if o.get("output_type") == "error"]
    assert not errors, "saved with an error in its outputs: {}".format(errors[0].get("evalue"))


@pytest.mark.parametrize("name", NOTEBOOKS)
def test_notebook_uses_only_roof_names_that_exist(name):
    import grid_roof

    used = {
        node.attr for node in ast.walk(ast.parse(code_of(name)))
        if isinstance(node, ast.Attribute) and isinstance(node.value, ast.Name) and node.value.id == "roof"
    }
    known = set(grid_roof.__all__)
    assert used <= known, "not in grid_roof: {}".format(sorted(used - known))
